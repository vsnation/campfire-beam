<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Test builds of BEAM Campfire, distributed outside the App Store. Not
     sandboxed: the BEAM core runs as child processes (wallet-api, beam-node)
     that the app installs and launches, which App Sandbox blocks unless they
     ship as signed, sandbox-inheriting helpers inside the bundle (planned for
     release builds, B-REL-SANDBOX). -->
<dict>
	<!-- file_picker (10.x) refuses every open/save/folder panel unless one of
	     the user-selected-files entitlements is present, sandbox or not:
	     without it "Install from file" (.dapp), Restore backup, and saving a
	     QR code or an export all fail. Read-write: saving needs it. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
