+    // Campfire (wasm patch 0107): Rescan from BEAM's recovery snapshot.
+    // Wallet::Rescan forgets every coin, except those a transaction under way is
+    // creating, and finds them again from the blockchain; a wallet without an
+    // owned node does that by reading every block since genesis. Here they are
+    // found again from the snapshot instead, so a coin that another copy of the
+    // seed spent while this wallet was not reading blocks stops showing as there.
+    // Forgetting and importing are one database transaction: if the snapshot
+    // cannot be read, the wallet is exactly as it was.
+    bool WalletDB::RescanFromRecovery(const std::string& path, INegotiatorGateway& gateway, IRecoveryProgress& prog)
+    {
+        flushDB(); // what came before is kept, whatever happens below
+
+        std::vector<Coin> keep;
+        std::vector<ShieldedCoin> keepShielded;
+        for (const auto& tx : getTxHistory(TxType::ALL, 0, std::numeric_limits<int>::max()))
+        {
+            if (tx.m_status != TxStatus::Pending && tx.m_status != TxStatus::InProgress && tx.m_status != TxStatus::Registering)
+                continue;
+            const auto created = getCoinsCreatedByTx(tx.m_txId);
+            keep.insert(keep.end(), created.begin(), created.end());
+            auto sc = getShieldedCoin(tx.m_txId);
+            if (sc && sc->m_createTxId && *sc->m_createTxId == tx.m_txId)
+                keepShielded.push_back(*sc);
+        }
+
+        bool ok = false;
+        try
+        {
+            clearCoins();
+            clearShieldedCoins();
+            saveCoins(keep);
+            for (const auto& sc : keepShielded)
+                saveShieldedCoin(sc);
+            deleteEventsFrom(0);
+            ok = ImportRecovery(path, gateway, prog);
+        }
+        catch (...)
+        {
+            rollbackDB();
+            throw;
+        }
+        if (!ok)
+        {
+            rollbackDB();
+            return false;
+        }
+        flushDB();
+        return true;
+    }
 
