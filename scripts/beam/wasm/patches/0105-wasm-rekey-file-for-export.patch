+    // Campfire (wasm patch 0105): re-key a COPY of a wallet database, for
+    // "Export wallet.db". The live wallet.db keeps its own (random) password;
+    // the app copies it into memory, re-keys the copy here to a password the
+    // person knows, and hands that copy out. Opens with the old key, proves it
+    // reads, rekeys, closes, then reopens read-only with the new key to prove
+    // the result. Never logs either password.
+    static bool RekeyFileImpl(const std::string& path, const std::string& oldPass, const std::string& newPass)
+    {
+        auto opens = [](sqlite3* db, const std::string& key)
+        {
+            return sqlite3_key(db, key.data(), static_cast<int>(key.size())) == SQLITE_OK
+                && sqlite3_exec(db, "SELECT count(*) FROM sqlite_master;", nullptr, nullptr, nullptr) == SQLITE_OK;
+        };
+        bool ok = false;
+        sqlite3* db = nullptr;
+        if (sqlite3_open_v2(path.c_str(), &db, SQLITE_OPEN_READWRITE, nullptr) == SQLITE_OK && opens(db, oldPass))
+        {
+            ok = sqlite3_rekey(db, newPass.data(), static_cast<int>(newPass.size())) == SQLITE_OK;
+        }
+        if (db)
+        {
+            sqlite3_close(db);
+            db = nullptr;
+        }
+        if (!ok)
+        {
+            return false;
+        }
+        ok = sqlite3_open_v2(path.c_str(), &db, SQLITE_OPEN_READONLY, nullptr) == SQLITE_OK && opens(db, newPass);
+        if (db)
+        {
+            sqlite3_close(db);
+        }
+        return ok;
+    }
+
+    static void RekeyFileThread(const std::string& path, const std::string& oldPass, const std::string& newPass, std::shared_ptr<val> cb)
+    {
+        auto res = RekeyFileImpl(path, oldPass, newPass);
+        BEAM_LOG_DEBUG() << __FUNCTION__ << TRACE(path) << TRACE(res);
+        auto cbPtr = std::make_unique<CallbackResult>(std::move(cb), res);
+        emscripten_async_run_in_main_runtime_thread(
+            EM_FUNC_SIG_VI,
+            &WasmWalletClient::ProsessCallbackOnMainThread,
+            reinterpret_cast<int>(cbPtr.release()));
+    }
+
+    // JS: WasmWalletClient.RekeyFile(path, oldPass, newPass, (ok) => ...)
+    static void RekeyFile(const std::string& path, const std::string& oldPass, const std::string& newPass, val cb)
+    {
+        auto pcb = std::make_shared<val>(cb);
+        MyThread(&WasmWalletClient::RekeyFileThread, path, oldPass, newPass, pcb).detach();
+    }
+
