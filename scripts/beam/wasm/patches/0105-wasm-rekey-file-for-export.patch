+#include "3rdparty/sqlite/sqlite3.h"
+// Campfire (wasm patch 0105): SQLCipher's key/rekey for RekeyFile below.
+// sqlite3.h declares them only under SQLITE_HAS_CODEC, which the sqlite
+// target defines for itself (wallet_core links it privately).
+extern "C" {
+int sqlite3_key(sqlite3* db, const void* pKey, int nKey);
+int sqlite3_rekey(sqlite3* db, const void* pKey, int nKey);
+}
 
