+    // Campfire (wasm patch 0106): "Show owner key". With the owner key a node
+    // the person runs recognises every coin of this seed, offline and
+    // max-privacy payments included; it can see them, not spend them. Exported
+    // exactly as `beam-wallet export_owner_key` and
+    // WalletClient::exportOwnerKey do: KeyString encrypted with `pass`, meta
+    // "0". `pass` is the password the person typed (the node is started with
+    // the same --pass), never the wallet.db password. Runs on the wallet
+    // thread, which owns the database; cb(key) on the main thread, cb(null)
+    // when the wallet is not running or the export failed. Neither the
+    // password nor the key is logged.
+    void ExportOwnerKey(const std::string& pass, val cb)
+    {
+        AssertMainThread();
+        if (!m_Client || !m_Client->isRunning() || pass.empty())
+        {
+            cb(val::null());
+            return;
+        }
+        // The callback stays on this thread: a val must not be released on another one.
+        const uint32_t id = ++m_OwnerKeyRequests;
+        m_OwnerKeyCallbacks.emplace(id, std::move(cb));
+        auto secret = std::make_shared<SecString>(pass);
+        std::weak_ptr<int> alive = m_Alive;
+        m_Client->getAsync()->makeIWTCall([client = m_Client.get(), secret]() -> boost::any
+        {
+            std::string key;
+            try
+            {
+                auto db = client->GetWalletDB();
+                auto ownerKdf = db ? db->get_OwnerKdf() : nullptr;
+                if (ownerKdf)
+                {
+                    KeyString ks;
+                    ks.SetPassword(Blob(secret->data(), static_cast<uint32_t>(secret->size())));
+                    ks.m_sMeta = std::to_string(0);
+                    ks.ExportP(*ownerKdf);
+                    key = std::move(ks.m_sRes);
+                }
+            }
+            catch (const std::exception&)
+            {
+                key.clear();
+            }
+            secret->erase();
+            return boost::any(std::move(key));
+        },
+        [this, alive, id](const boost::any& res)
+        {
+            if (alive.expired())
+            {
+                return;
+            }
+            auto it = m_OwnerKeyCallbacks.find(id);
+            if (it == m_OwnerKeyCallbacks.end())
+            {
+                return;
+            }
+            val cb = std::move(it->second);
+            m_OwnerKeyCallbacks.erase(it);
+            auto* key = boost::any_cast<std::string>(&const_cast<boost::any&>(res));
+            if (key && !key->empty())
+            {
+                cb(*key);
+                ECC::SecureErase(key->data(), static_cast<uint32_t>(key->size()));
+            }
+            else
+            {
+                cb(val::null());
+            }
+        });
+    }
+
