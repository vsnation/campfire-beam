+    // Campfire: per-shader privilege for invoke_contract.
+    //
+    // Stock wallet-api runs every app shader at privilege 0: one IShadersManager,
+    // created at privilege 0. A few shaders need privilege 1 to derive keys from the
+    // master KDF (get_PkEx, get_BlindSk, SetKernelAdv without a foreign signature),
+    // e.g. BANS "user view" / "receive_all". Raising the privilege for every shader would
+    // let any dApp shader derive the keys other dApps use, so privilege 1 is granted only
+    // to shaders whose SHA-256 (of the exact `contract` bytes the client sends) is listed
+    // in --privileged_shader_sha256. Every other shader runs at privilege 0, as stock.
+    class PrivilegeRoutingShadersManager : public IShadersManager
+    {
+    public:
+        PrivilegeRoutingShadersManager(Wallet& wallet, std::vector<ECC::Hash::Value> privileged)
+            : _wallet(wallet)
+            , _privileged(std::move(privileged))
+            , _std(IShadersManager::CreateInstance(wallet, "", "", 0))
+        {
+        }
+
+        void CallShaderAndStartTx(std::vector<uint8_t>&& shader, std::string&& args, unsigned method, uint32_t priority, uint32_t unique, DoneAllHandler doneHandler) override
+        {
+            route(shader).CallShaderAndStartTx(std::move(shader), std::move(args), method, priority, unique, std::move(doneHandler));
+        }
+
+        void CallShader(std::vector<uint8_t>&& shader, std::string&& args, unsigned method, uint32_t priority, uint32_t unique, DoneCallHandler doneHandler) override
+        {
+            route(shader).CallShader(std::move(shader), std::move(args), method, priority, unique, std::move(doneHandler));
+        }
+
+        void ProcessTxData(const ByteBuffer& data, DoneTxHandler doneHandler) override
+        {
+            // process_invoke_data takes invoke data back from the client. When it carries an
+            // app invocation to re-run later (dependent transactions), contract_transaction.cpp
+            // re-runs that app body at the privilege stored in the data, so a client could ask
+            // for any privilege with any body. Accept a non-zero privilege only for a body this
+            // process compiled from an allowlisted shader, and never above 1.
+            bvm2::ContractInvokeData invokeData;
+            if (fromByteBuffer(data, invokeData) && invokeData.m_AppInvoke.m_Privilege)
+            {
+                ECC::Hash::Value hv;
+                ECC::Hash::Processor() << Blob(invokeData.m_AppInvoke.m_App) >> hv;
+                if ((invokeData.m_AppInvoke.m_Privilege > 1) || !_privilegedBodies.count(hv))
+                {
+                    BEAM_LOG_WARNING() << "process_invoke_data refused: app privilege " << invokeData.m_AppInvoke.m_Privilege << " was not granted to this shader";
+                    return doneHandler(boost::none, std::string("invoke data requests a shader privilege that was not granted"));
+                }
+            }
+            _std->ProcessTxData(data, std::move(doneHandler));
+        }
+
+        bool IsDone() const override
+        {
+            return _std->IsDone() && (!_priv || _priv->IsDone());
+        }
+
+    private:
+        IShadersManager& route(const std::vector<uint8_t>& shader)
+        {
+            // An empty `contract` reuses the body compiled last, so it stays on the manager
+            // (and therefore the privilege) that compiled that body.
+            if (!shader.empty())
+            {
+                ECC::Hash::Value hv;
+                ECC::Hash::Processor() << Blob(shader) >> hv;
+                _lastPrivileged = std::find(_privileged.begin(), _privileged.end(), hv) != _privileged.end();
+                if (_lastPrivileged)
+                {
+                    if (!_priv)
+                        _priv = IShadersManager::CreateInstance(_wallet, "", "", 1);
+                    rememberBody(shader);
+                    BEAM_LOG_INFO() << "app shader " << to_hex(hv.m_pData, hv.nBytes) << " runs at privilege 1";
+                }
+            }
+            return _lastPrivileged ? *_priv : *_std;
+        }
+
+        void rememberBody(const std::vector<uint8_t>& shader)
+        {
+            try
+            {
+                ByteBuffer body;
+                bvm2::Processor::Compile(body, Blob(shader), bvm2::Processor::Kind::Manager);
+                ECC::Hash::Value hv;
+                ECC::Hash::Processor() << Blob(body) >> hv;
+                _privilegedBodies.insert(hv);
+            }
+            catch (const std::exception&)
+            {
+                // the manager compiles it again and reports the error to the caller
+            }
+        }
+
+        Wallet& _wallet;
+        std::vector<ECC::Hash::Value> _privileged;
+        std::set<ECC::Hash::Value> _privilegedBodies;
+        IShadersManager::Ptr _std;
+        IShadersManager::Ptr _priv;
+        bool _lastPrivileged = false;
+    };
+
+    // Campfire: parse --privileged_shader_sha256 (comma-separated, 64 hex digits each).
+    bool parsePrivilegedShaders(const std::string& list, std::vector<ECC::Hash::Value>& out)
+    {
+        auto nibble = [](char c) -> int
+        {
+            if (c >= '0' && c <= '9') return c - '0';
+            if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+            if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+            return -1;
+        };
+
+        for (auto item : string_helpers::split(list, ','))
+        {
+            boost::algorithm::trim(item);
+            ECC::Hash::Value hv;
+            bool ok = (item.size() == hv.nBytes * 2);
+            for (uint32_t i = 0; ok && (i < hv.nBytes); i++)
+            {
+                int hi = nibble(item[2 * i]), lo = nibble(item[2 * i + 1]);
+                ok = (hi >= 0) && (lo >= 0);
+                if (ok)
+                    hv.m_pData[i] = static_cast<uint8_t>((hi << 4) | lo);
+            }
+
+            if (!ok)
+            {
+                BEAM_LOG_ERROR() << "--privileged_shader_sha256: not a 64-digit hex SHA-256: \"" << item << "\"";
+                return false;
+            }
+            out.push_back(hv);
+        }
+        return true;
+    }
+
