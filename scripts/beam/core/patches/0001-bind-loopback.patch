@@ -390,7 +390,11 @@ int main(int argc, char* argv[])
 					node.m_Cfg.m_Observer = &observer;
 
 					node.m_Cfg.m_Listen.port(port);
-					node.m_Cfg.m_Listen.ip(INADDR_ANY);
+					// Campfire: wallet-private node. Accept P2P connections from this machine only
+					// (our wallet-api). Outbound connections to peers, and so sync, are unaffected.
+					node.m_Cfg.m_Listen.ip(io::Address::LOCALHOST.ip());
+					// The UDP LAN beacon binds 0.0.0.0 and advertises a port no other host can reach.
+					node.m_Cfg.m_BeaconPeriod_ms = 0;
 					node.m_Cfg.m_sPathLocal = vm[cli::STORAGE].as<string>();
 
 					if (Rules::get().m_Consensus == Rules::Consensus::PoW)
