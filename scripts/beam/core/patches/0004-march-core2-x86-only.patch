Pass -march=core2 only when targeting x86.

The top-level CMakeLists.txt and the bundled re2 add -march=core2 on every non-Apple-M1
Unix host. core2 is an x86 CPU, so gcc on aarch64 Linux fails with
"unknown value core2 for -march". x86 builds are unchanged.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -261,9 +261,9 @@
         else()
             if(ARCH_NATIVE)
                 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=native")
-            else()
+            elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|i[3-6]86)$")
+                # Campfire: core2 is an x86 CPU; gcc/clang reject it on aarch64.
                 set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=core2")
-                
             endif()
         endif()
     endif()
diff --git a/3rdparty/re2/CMakeLists.txt b/3rdparty/re2/CMakeLists.txt
index b46ca04..8ac712b 100644
--- a/3rdparty/re2/CMakeLists.txt
+++ b/3rdparty/re2/CMakeLists.txt
@@ -48,9 +48,9 @@ else()
     else()
       if(ARCH_NATIVE)
         set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=native")
-      else()
+      elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|i[3-6]86)$")
+        # Campfire: core2 is an x86 CPU; gcc/clang reject it on aarch64.
         set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -march=core2")
-
       endif()
     endif()
   endif()
